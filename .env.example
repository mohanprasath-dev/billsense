NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini AI API Key (Server-side OCR & Chatbot Assistant)
GEMINI_API_KEY=your-gemini-api-key

# Resend API Key (Optional: Feedback email notifications & auto-reply)
RESEND_API_KEY=your-resend-api-key

# Google Service Account (Optional: Google Sheets feedback append)
# Sheet ID: 1WzOJrhMehkjMkzD5NUFOpvG2UNWGxCxS8jEIU6XuDt8 (Share sheet with service account email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
